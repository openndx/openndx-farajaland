# Exchange Services - Environment Configuration Template
# Copy this file to .env.local or .env.production and customize values
# Usage: docker compose --env-file .env.local up --build

# =============================================================================
# ENVIRONMENT CONFIGURATION
# =============================================================================
# Environment: development, staging, or production
ENVIRONMENT=development

# Logging configuration
LOG_LEVEL=info          # Options: debug, info, warn, error
LOG_FORMAT=text         # Options: text, json

# =============================================================================
# BUILD CONFIGURATION
# =============================================================================
BUILD_VERSION=dev
BUILD_TIME=2025-09-15T14:30:00Z
GIT_COMMIT=local

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
DB_USER=exchange
DB_PASSWORD=1234
DB_PORT=5432
DB_NAME=testdb2

# =============================================================================
# SERVICE PORTS
# =============================================================================
# Policy Decision Point service port
PORT_PDP=8082

# Consent Engine service port
PORT_CE=8081

# Orchestration Engine service port
PORT_OE=4000

# =============================================================================
# GENERAL SERVICE CONFIGURATION
# =============================================================================
# Backend ports and timeouts are set in the YAML files.
# The Go services listen on all interfaces by default.

# =============================================================================
# POLICY DECISION POINT (PDP) - DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection for PDP
PDP_DB_HOST=postgres
PDP_DB_PORT=5432
PDP_DB_USERNAME=exchange
PDP_DB_PASSWORD=1234
PDP_DB_NAME=testdb2

# SSL mode for database connections: disable, allow, prefer, require, verify-ca, verify-full
DB_SSLMODE=disable

# =============================================================================
# CONSENT ENGINE (CE) - DATABASE CONFIGURATION
# =============================================================================
# PostgreSQL database connection for Consent Engine
CE_DB_HOST=postgres
CE_DB_PORT=5432
CE_DB_USERNAME=exchange
CE_DB_PASSWORD=1234
CE_DB_NAME=testdb2

# Consent Portal URL (for redirects and notifications)
CONSENT_PORTAL_URL=http://localhost:5173
CONSENT_PORTAL_CLIENT_ID=CONSENT_PORTAL_APP

# =============================================================================
# ORCHESTRATION ENGINE (OE) - CONFIGURATION
# =============================================================================
# Host paths, relative to ndx/docker-compose.yml
OE_CONFIG_PATH=./config/openndx/oe.yaml
OE_SCHEMA_PATH=./schema.graphql

# Backend settings live in config/openndx/{pdp,ce,oe}.yaml.
# Compose passes only the variables those files explicitly reference.

# =============================================================================
# IDP CONFIGURATION (ThunderID)
# =============================================================================
# NOTE: changing IDP_PORT/IDP_BASE_URL here does NOT change ThunderID's own
# listen address - config/thunderid/deployment.yaml hardcodes hostname/
# public_url/port as literals (see the comment there for why they can't be
# templated from these vars), and other services (apisix routes, the
# consent-portal SPA redirect, etc.) also hardcode localhost:8090. Changing
# ThunderID's port/URL means updating deployment.yaml and those too.
IDP_PORT=8090
# The OIDC issuer must resolve identically for the host browser AND the containers.
# For this local-only HTTP stack we use `localhost`: the browser reaches it
# directly, while containers compare the issuer string and fetch JWKS over
# Docker DNS. No /etc/hosts entry is needed.
IDP_BASE_URL=http://localhost:8090
IDP_ISSUER=http://localhost:8090
IDP_AUDIENCE=CONSENT_PORTAL_APP
# OE has its own API audience, requested by data consumers as OAuth `resource`.
# Keep this in sync with config/thunderid/bootstrap/06-oe-resource.yaml.
OE_IDP_AUDIENCE=http://api.openndx.local
# JWKS is fetched server-side (consent-engine) from inside the Docker network, so
# it stays on the in-network `thunderid` hostname (resolved via Docker DNS).
IDP_JWKS_URL=http://thunderid:8090/oauth2/jwks
# Custom claim CE matches against consent.owner_id. Citizen.nic carries the
# email-shaped ID already used by the mock providers and existing consents.
IDP_SUBJECT_CLAIM=nic

# ThunderID service configuration (ndx/docker-compose.yml thunderid* services)
THUNDERID_IMAGE_TAG=1.0.1
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
ADMIN_CLI_SECRET=1234
# Gates ThunderID's Direct API (atomic auth / /flow/execute). Pinned so
# thunderid-setup doesn't generate a random secret on every run.
DIRECT_AUTH_SECRET=1234
# Declarative bootstrap app secret (config/thunderid/bootstrap/03-gateway-app.yaml)
# - pinned so it's stable across `docker compose up` runs instead of needing a
# fresh admin-token dance each time (see init.sh).
GATEWAY_CLIENT_SECRET=1234
# Passport app data-consumer secret (config/thunderid/data-consumers/
# passport-application.yaml) - registered at runtime by init.sh via
# ThunderID's /import API, not part of thunderid-setup's own bootstrap.
PASSPORT_CLIENT_SECRET=1234
# Demo citizen user (config/thunderid/demo-citizens/mock-user.yaml), matching
# the DRP/RGD mock data's "nayana@opensource.lk" record - registered at
# runtime by init.sh via ThunderID's /import API, same as the passport app.
MOCK_USER_PASSWORD=Abc12#45
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=dummy
SMTP_PASSWORD=dummy
SMTP_FROM_ADDRESS=noreply@farajaland.local
SMTP_ENABLE_START_TLS=false
SMTP_ENABLE_AUTHENTICATION=false

# =============================================================================
# AUDIT SERVICE CONFIGURATION
# =============================================================================
AUDIT_SERVICE_IMAGE_TAG=1103abbd087e5cc9d7e17c42bfb2395a6c9dcc57
AUDIT_DB_TYPE=postgres
AUDIT_DB_HOST=postgres
AUDIT_DB_PORT=5432
AUDIT_DB_USERNAME=exchange
AUDIT_DB_PASSWORD=1234
AUDIT_DB_NAME=audit-db
# Fail-closed API key argus (audit-service) requires on every request;
# orchestration-engine's audit client must send the same value.
ARGUS_API_KEY=test-audit-token

# Provider credentials expanded by config/openndx/oe.yaml at startup.
DRP_API_KEY=chk_eyJjb25uZWN0aW9uLWlkIjoiMDFmMGFiMWMtMDZjYy0xYmJlLWE1MTUtODU1ZTA5NzEwMWNmIiwia2V5Ijoiajg3cDQ0MGFxNHFiZ3g2aWJuMjJrYW4zcGNnbmZ5cHp2NnR6M3Z2dmt6cGZlcjVmMDQ5byJ9cZY3Ew
RGD_CLIENT_ID=2oIRGWpHDjmTPqDo8tOJCu2DwANp
RGD_CLIENT_SECRET=xJclnZNorKGwLJPpKQRAtqK1ZtJh
